{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/allow-playwright-cli.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[qa-powers] 已就绪。用户提到 UI 测试/设计用例/跑用例/测试报告时，先读取 using-qa-powers skill。'"
          }
        ]
      }
    ]
  }
}
